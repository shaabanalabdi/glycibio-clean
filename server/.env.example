# ============================================================
# GlyciBio API — Variables d'environnement requises
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Serveur
PORT=5000
NODE_ENV=development

# Base de donnees MySQL
# DB_USER doit etre un utilisateur dedie a privileges restreints (jamais root).
# Avec Docker Compose, l'image MySQL cree cet utilisateur avec ALL PRIVILEGES
# uniquement sur la base ${DB_NAME} (principe du moindre privilege).
DB_HOST=localhost
DB_PORT=3306
DB_USER=glycibio_app
DB_PASSWORD=your_app_db_password
DB_NAME=glycibio
# Mot de passe root MySQL — utilise uniquement par Docker pour l'initialisation
# du conteneur (l'API ne se connecte jamais en root).
DB_ROOT_PASSWORD=your_mysql_root_password

# JWT
JWT_SECRET=your_very_long_random_secret_key_min_32_chars
JWT_REFRESH_SECRET_KEY=another_very_long_random_secret_key_min_32_chars
JWT_ALGO=HS256
JWT_EXPIRES_IN=24h

# CORS — URL du frontend en production
CORS_ORIGIN=http://localhost:5173

# Stripe (paiement)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL du frontend (pour les emails et redirections Stripe)
CLIENT_URL=http://localhost:5173

# URL publique du site — utilisee pour les liens dans les emails ET pour
# sitemap.xml / URLs canoniques. Sans valeur, le code retombe sur
# https://glycibio.fr : a definir si le domaine reel differe.
PUBLIC_BASE_URL=https://glycibio.fr

# SameSite des cookies d'authentification : lax (defaut) ou strict.
# 'none' est rejete et ramene a lax (pas de cookies cross-site ici).
COOKIE_SAMESITE=lax

# Email SMTP (optionnel — pour les emails de confirmation et reinitialisation mdp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application

# ============================================================
# Sentry — suivi des erreurs en production (optionnel mais recommande)
# Activation en 2 etapes : (1) installer le paquet -> `npm install @sentry/node`
# puis (2) renseigner SENTRY_DSN ci-dessous. Sans DSN, c'est un no-op silencieux ;
# avec DSN mais sans le paquet, l'API logge une ERREUR au demarrage (pas de
# faux sentiment de monitoring).
# ============================================================
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
# Version applicative (correle les erreurs Sentry a un deploiement)
APP_VERSION=1.5.0

# Observabilite / logs
LOG_LEVEL=info
LOG_FORMAT=json
# Derriere Nginx (reverse-proxy) : 1 = faire confiance au 1er hop (vraie IP)
TRUST_PROXY=1

# Taches planifiees (crons : panier abandonne, etc.). Mettre 1 pour les
# desactiver (CI, tests, ou instance secondaire qui ne doit pas les executer).
# DISABLE_CRON=1

# Sauvegardes BDD (script `npm run backup:db` -> server/scripts/backup-db.cjs)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14
# MYSQLDUMP_BIN=mysqldump
