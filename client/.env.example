# URL de l'API consommee par le front :
#  - DEV  (API sur un port distinct)  : http://localhost:5000/api
#  - PROD (front + API meme origine)  : /api  (relatif — valeur forcee par le
#    build Docker/CI ; same-origin derriere Nginx, cf. deploy/nginx)
VITE_API_URL=http://localhost:5000/api

# Sentry front (optionnel) — suivi des erreurs cote client.
# Laisser vide pour desactiver. Pour activer : `npm install @sentry/react` puis
# renseigner ce DSN.
VITE_SENTRY_DSN=
